From fa22446be3e09b988ce85457e2a2f221ad8b5cef Mon Sep 17 00:00:00 2001
From: frank_chiang <frank_chiang@asus.com>
Date: Mon, 26 Feb 2024 16:10:28 +0800
Subject: [PATCH] fastboot: support authenticated unlock using embedded hash

Change-Id: Iea4498d667f0ec3210624516f893f628c6a01c99
---
 drivers/usb/gadget/f_fastboot.c       |  4 ++--
 include/android_avb/rk_avb_ops_user.h | 13 +++++++++++++
 lib/avb/rk_avb_user/rk_avb_ops_user.c | 27 +++++++++++++++++++++++++++
 3 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/gadget/f_fastboot.c b/drivers/usb/gadget/f_fastboot.c
index 2a215db141..5b9bd32840 100644
--- a/drivers/usb/gadget/f_fastboot.c
+++ b/drivers/usb/gadget/f_fastboot.c
@@ -2240,9 +2240,9 @@ static void cb_oem(struct usb_ep *ep, struct usb_request *req)
 		} else {
 			lock_state = 1;
 #ifdef CONFIG_RK_AVB_LIBAVB_ENABLE_ATH_UNLOCK
-			if (rk_auth_unlock((void *)CONFIG_FASTBOOT_BUF_ADDR,
+			if (rk_uboot_auth_unlock((void *)CONFIG_FASTBOOT_BUF_ADDR,
 					   &out_is_trusted)) {
-				printf("rk_auth_unlock ops error!\n");
+				printf("rk_uboot_auth_unlock ops error!\n");
 				fastboot_tx_write_str("FAILrk_auth_unlock ops error!");
 				return;
 			}
diff --git a/include/android_avb/rk_avb_ops_user.h b/include/android_avb/rk_avb_ops_user.h
index 97a6967f74..dbcade5928 100644
--- a/include/android_avb/rk_avb_ops_user.h
+++ b/include/android_avb/rk_avb_ops_user.h
@@ -17,6 +17,7 @@ extern "C" {
 /* rk used */
 #define PERM_ATTR_DIGEST_SIZE		32
 #define PERM_ATTR_TOTAL_SIZE		1052
+#define UNLOCK_CREDENTIAL_SIZE		3756
 #define VBOOT_KEY_HASH_SIZE		32
 #define ANDROID_VBOOT_LOCK		0
 #define ANDROID_VBOOT_UNLOCK		1
@@ -275,6 +276,18 @@ AvbABFlowResult rk_avb_ab_slot_select(AvbABOps* ab_ops,char select_slot[]);
  */
 int rk_auth_unlock(void *buffer, char *out_is_trusted);
 
+
+/**
+ * authenticated unlock using the embedded hash in uboot
+ *
+ * @param buffer: AvbAtxUnlockCredential
+ *
+ * @param out_is_trusted: true or false
+ *
+ * @return 0 if authenticated unlock OK, -1 if not
+ */
+int rk_uboot_auth_unlock(void *buffer, char *out_is_trusted);
+
 /**
  * generate unlock challenge
  *
diff --git a/lib/avb/rk_avb_user/rk_avb_ops_user.c b/lib/avb/rk_avb_user/rk_avb_ops_user.c
index a536fd99ac..ad3d47ada8 100644
--- a/lib/avb/rk_avb_user/rk_avb_ops_user.c
+++ b/lib/avb/rk_avb_user/rk_avb_ops_user.c
@@ -27,6 +27,12 @@
 #include <u-boot/sha256.h>
 #include <asm/arch/rk_atags.h>
 
+unsigned char atx_unlock_credential_hash[] = {
+  0xba, 0xaf, 0x29, 0xcd, 0x69, 0x4d, 0xa0, 0x54, 0xaa, 0x58, 0x4a, 0x7c,
+  0xe5, 0xe9, 0xa8, 0x81, 0xe7, 0x87, 0xfe, 0xc4, 0xdb, 0x89, 0xc7, 0x7b,
+  0xba, 0xd9, 0x3f, 0xf7, 0x82, 0x3a, 0x66, 0xd6
+};
+
 /* rk used */
 int rk_avb_get_pub_key(struct rk_pub_key *pub_key)
 {
@@ -615,6 +621,27 @@ int rk_auth_unlock(void *buffer, char *out_is_trusted)
 		return -1;
 }
 
+int rk_uboot_auth_unlock(void *buffer, char *out_is_trusted)
+{
+	*out_is_trusted = false;
+
+	sha256_context ctx;
+	uint8_t digest[SHA256_SUM_LEN] = {0};
+
+	sha256_starts(&ctx);
+	sha256_update(&ctx, (const uint8_t *)buffer,
+			UNLOCK_CREDENTIAL_SIZE);
+	sha256_finish(&ctx, digest);
+
+	if (memcmp(digest, atx_unlock_credential_hash, SHA256_SUM_LEN) == 0)
+		*out_is_trusted = true;
+
+	if (*out_is_trusted == true)
+		return 0;
+	else
+		return -1;
+}
+
 int rk_generate_unlock_challenge(void *buffer, uint32_t *challenge_len)
 {
 	AvbOps* ops;
-- 
